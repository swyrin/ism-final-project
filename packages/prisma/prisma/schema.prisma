// Prisma schema for ISM (Knowledge Management System)
// Maps to the existing SQLite database schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id      String            @id
  title   String
  history DocumentHistory[]
  files   File[]
}

model DocumentHistory {
  did         String
  modified_at DateTime
  document    Document @relation(fields: [did], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([did, modified_at])
  @@map("Document_History")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  files File[]
}

model File {
  id          String        @id
  title       String
  cid         Int
  author      String
  description String
  did         String
  view        Int           @default(0)
  storagePath String        @default("")
  category    Category      @relation(fields: [cid], references: [id], onDelete: Cascade, onUpdate: Cascade)
  document    Document      @relation(fields: [did], references: [id], onDelete: Cascade, onUpdate: Cascade)
  history     FileHistory[]
}

model FileHistory {
  fid         String
  modified_at DateTime
  file        File     @relation(fields: [fid], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([fid, modified_at])
  @@map("File_History")
}
